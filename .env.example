OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
TTS_CHUNK_BYTES=1024

# Bearer token the telephony backend must send on the WebSocket handshake
AI_BRIDGE_TOKEN=
AI_BRIDGE_HOST=0.0.0.0
AI_BRIDGE_PORT=8080
LOG_LEVEL= DEBUG
RESTAURANT_API_BASE=http://127.0.0.1:3001

# Catalog cache (v2). Leave REDIS_URL empty to run like v1 — no Redis, no background sync.
#
REDIS_URL=
REDIS_NAMESPACE=aibridge
SYNC_ENABLED=true
SYNC_POLL_SECONDS=300
SYNC_TIMEOUT=10
# Optional; empty falls back to RESTAURANT_API_BASE
SYNC_API_BASE=
SYNC_MAX_BACKOFF_SECONDS=2400
CACHE_GENERATION_TTL=10800
CACHE_TTL_SECONDS=600
CALL_END_GRACE_MS=300
DTMF_MENU_TIMEOUT_SECONDS=7
DTMF_DEBOUNCE_MS=500
DTMF_MAX_INVALID=2

# --- Telnyx Call Control v2 + Media Streaming (inbound) ---
# Leave TELNYX_ENABLED=false to run exactly like before.
TELNYX_ENABLED=false
# Keep the legacy /v1/bridge socket (telephony backend + browser demo) mounted.
BRIDGE_ENABLED=true
TELNYX_API_KEY=
TELNYX_API_BASE=https://api.telnyx.com/v2
# Base64 Ed25519 public key from Telnyx portal > Account > Keys & Credentials
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_TOLERANCE_SECONDS=300
# Public wss:// URL of THIS service. Telnyx cannot reach localhost — use ngrok in dev.
TELNYX_STREAM_URL=wss://your-host.example/telnyx/media
# Shared secret appended as ?token=; Telnyx does not sign the media WebSocket.
TELNYX_STREAM_TOKEN=
TELNYX_STREAM_CODEC=L16
TELNYX_STREAM_TRACK=inbound_track
TELNYX_BIDI_CODEC=L16
# 8000 / 16000 / 22050 / 24000 / 48000. L16 is documented at 16000.
TELNYX_BIDI_SAMPLING_RATE=16000
# Outbound frame size; Telnyx accepts 20 ms and up.
TELNYX_FRAME_MS=20
TELNYX_DEFAULT_LOCALE=en
TELNYX_DEFAULT_TIMEZONE=UTC
TELNYX_DEFAULT_STORE_NAME=
# Spoken verbatim on answer; the DTMF service menu is appended automatically.
TELNYX_GREETING=Hello, you have reached our automated assistant.
TELNYX_MARK_TIMEOUT_SECONDS=20

# RFC 2586 noi L16 la big-endian, NHUNG Telnyx thuc te gui little-endian.
# Da kiem chung bang cuoc goi that 16/09/2026: de true -> tieng re trang ca hai
# chieu va khong co loi nao duoc bao. Giu false cho Telnyx.
TELNYX_L16_BYTESWAP=false
