# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech (same OPENAI_API_KEY as LLM)
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Booking backend
BOOKING_API_URL=http://127.0.0.1:8001
MULTI_BRANCH=true

# Voice agent (LLM + STT/TTS for the browser phone)
VOICE_AGENT_URL=http://127.0.0.1:8000

# Browser phone simulator
BROWSER_SIM_PORT=8002
BROWSER_SIM_BASE_URL=http://127.0.0.1:8002

# Knowledge / RAG
KNOWLEDGE_DIR=knowledge
CHROMA_PATH=.chroma
USE_CHROMA=false
