OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Bearer token the telephony backend must send on the WebSocket handshake
AI_BRIDGE_TOKEN=
AI_BRIDGE_HOST=0.0.0.0
AI_BRIDGE_PORT=8080
LOG_LEVEL=INFO

# Restaurant server that receives booking / delivery requests. Staff call the
# customer back to confirm availability. Leave the URL empty to use the
# in-memory stub, which files nowhere.
STORE_API_URL=
STORE_API_TOKEN=
STORE_API_TIMEOUT=5.0
