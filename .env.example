# Copy to `.env` and fill in. Every key here is validated at boot by
# src/config/env.schema.ts — a missing or malformed value crashes the process
# on startup rather than failing on the first phone call.

NODE_ENV=development
PORT=3000

# Postgres. The compose file publishes the container's 5432 on host port 5433,
# because a locally-installed PostgreSQL usually already owns 5432 — on Windows
# both can bind it and connections silently reach the wrong server.
#
# From the host:                    localhost:5433
# From another container on the
# compose network:                  db:5432   (service name, internal port)
#
# Host:   postgresql://receptionist:receptionist@localhost:5433/ai_receptionist?schema=public
# Docker: postgresql://receptionist:receptionist@db:5432/ai_receptionist?schema=public
DATABASE_URL=

# OpenAI — brain, speech-to-text, and text-to-speech.
OPENAI_API_KEY=

# Twilio. ACCOUNT_SID is 34 characters and starts with "AC".
# PHONE_NUMBER must be E.164, e.g. +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public https:// origin Twilio can reach — a tunnel in development, the
# deployed host in production. The wss:// media-stream URL is derived from it.
PUBLIC_BASE_URL=

# Seed values only. Once `prisma db seed` has run, the Store row is the source
# of truth for name, timezone, locale, and greetings — runtime code reads the
# database, never these variables.
STORE_NAME=
STORE_TIMEZONE=Europe/Berlin
DEFAULT_LOCALE=en

# Model selection. Defaults are applied when omitted.
LLM_MODEL=gpt-5.6-terra
STT_MODEL=gpt-live-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin
