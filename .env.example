# Biến cho docker-compose.yml ở root. Copy thành .env (make setup tự làm) rồi điền.

# ngrok chạy trong Docker để Telnyx gọi vào AI Bridge trên máy này.
# Lấy authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Static domain miễn phí: https://dashboard.ngrok.com/domains  (vd: abc-xyz.ngrok-free.app)
# Bỏ trống thì script tự lấy host từ TELNYX_STREAM_URL trong AI/.env.
# Domain này phải trùng Webhook URL / Stream URL đã khai trên portal Telnyx.
NGROK_DOMAIN=
