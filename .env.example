OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
TTS_CHUNK_BYTES=1024

# Bearer token the telephony backend must send on the WebSocket handshake
AI_BRIDGE_TOKEN=
AI_BRIDGE_HOST=0.0.0.0
AI_BRIDGE_PORT=8080
LOG_LEVEL=INFO
RESTAURANT_API_BASE=http://127.0.0.1:3001

# Catalog cache (v2). Leave REDIS_URL empty to run like v1 — no Redis, no background sync.
#
REDIS_URL=
REDIS_NAMESPACE=aibridge
SYNC_ENABLED=true
SYNC_POLL_SECONDS=300
SYNC_TIMEOUT=10
# Optional; empty falls back to RESTAURANT_API_BASE
SYNC_API_BASE=
SYNC_MAX_BACKOFF_SECONDS=2400
CACHE_GENERATION_TTL=10800
CACHE_TTL_SECONDS=600
CALL_END_GRACE_MS=300
DTMF_MENU_TIMEOUT_SECONDS=7
DTMF_DEBOUNCE_MS=500
DTMF_MAX_INVALID=2
