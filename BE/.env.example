NODE_ENV=development
PORT=8070
# FE chạy ở 3070 (xem FE/vite.config.ts); thêm origin khác thì ngăn cách bởi dấu phẩy
CORS_ORIGIN=http://localhost:3070

# Postgres trong docker-compose.yml ở root (cổng 5433 -> 5432 trong container)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=receptionist
DB_PASSWORD=receptionist
DB_NAME=restaurant_ai
DB_SSL=false
